# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.venv-local/

# Build / packaging
*.egg-info/
build/
dist/
.eggs/
*.egg

# Test / coverage
.pytest_cache/
.coverage
htmlcov/

# Env / local
.env
.env.*
.venv*/
*.local

# rolling T-1 baseline (regenerated each nightly run)
ledger/prev_index.json

# HTTP response cache (local dev convenience; CI runs cold)
.cache/

# Per-symbol OHLCV: ~32KB x universe size, regenerated every run. At Russell 1000
# scale that is ~33MB per nightly commit, which would bloat the repo beyond use
# within a fortnight. The build regenerates it and ships it in the Pages artifact;
# only the small bundled downsample (ledger/history.json) is committed.
ledger/history/
